# Copy to .env (root, git-ignored) for local development.
# See docker-compose.yml for the matching local Postgres/Redis containers.

# ---- Database ----
DATABASE_URL="postgresql://abytetex:abytetex@localhost:5432/abytetex?schema=public"

# ---- Redis / Queue ----
REDIS_URL="redis://localhost:6379"

# ---- Auth ----
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_REFRESH_EXPIRES_IN="30d"

# ---- API ----
API_PORT=3012
API_URL="http://localhost:3012"
CORS_ORIGIN="http://localhost:5185"
NODE_ENV="development"

# ---- Object storage (S3-compatible; e.g. MinIO locally) ----
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="abytetex-files"
S3_ACCESS_KEY_ID="abytetex"
S3_SECRET_ACCESS_KEY="abytetex-secret"
S3_FORCE_PATH_STYLE=true

# ---- Mail (optional; unset = MailService logs instead of sending, see D-016) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AbyteTex <no-reply@abytetex.com>"

# ---- Frontend ----
PORT=5185
NEXT_PUBLIC_API_URL="http://localhost:3012/api/v1"

# ---- Platform bootstrap (used by prisma/seed.ts) ----
PLATFORM_SUPER_ADMIN_EMAIL="admin@abytesol.com"
PLATFORM_SUPER_ADMIN_PASSWORD="ChangeMe123!"
